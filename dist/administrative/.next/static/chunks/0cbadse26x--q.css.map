.page {
  width: 100%;
  min-height: calc(100vh - 120px);
  border-radius: 14px;
  padding: 28px 30px;
  background: transparent;
}

.panel {
  width: 95%;
  max-width: 100%;
  background: #ffffff;
  border: 1px solid #dbe4f2;
  border-radius: 14px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  padding: 20px 22px;
}

.kicker {
  margin: 0;
  color: #2563eb;
  font-size: 1.2rem;
  font-weight: 700;
}

.title {
  margin: 2px 0 12px;
  color: #1e293b;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.04;
  letter-spacing: 0.2px;
}

.subtitle {
  margin: 0;
  color: #334155;
  font-size: 1.05rem;
  line-height: 1.45;
}

.noticeCard {
  margin-top: 20px;
  border-radius: 12px;
  border: 1px solid;
  padding: 18px 16px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.92);
}

.iconBubble {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  font-weight: 800;
  flex-shrink: 0;
}

.warningCard {
  border-color: #f8d79d;
}

.warningIcon {
  color: #d97706;
  background: #fff6e7;
}

.infoCard {
  border-color: #bcd4f7;
}

.infoIcon {
  color: #2563eb;
  background: #e9f1ff;
}

.dangerCard {
  border-color: #f8b5b5;
}

.dangerIcon {
  color: #dc2626;
  background: #ffecec;
}

.cardTitle {
  margin: 2px 0 8px;
  font-size: 1.02rem;
  font-weight: 800;
  letter-spacing: 0.2px;
}

.warningCard .cardTitle {
  color: #d97706;
}

.infoCard .cardTitle {
  color: #1d4ed8;
}

.dangerCard .cardTitle {
  color: #dc2626;
}

.cardText {
  margin: 0;
  color: #334155;
  font-size: 0.95rem;
  line-height: 1.5;
}

.cardText + .cardText {
  margin-top: 6px;
}

@media (max-width: 900px) {
  .page {
    padding: 16px;
  }

  .panel {
    padding: 16px;
  }

  .noticeCard {
    padding: 14px;
    gap: 10px;
  }

  .iconBubble {
    width: 38px;
    height: 38px;
    font-size: 1.05rem;
  }
}
