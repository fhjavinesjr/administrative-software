.container {
  padding: 2rem;
  max-width: 1100px;
}

.loadingText {
  padding: 2rem;
  color: #6c757d;
  font-size: 1rem;
}

.headerSection {
  margin-bottom: 2rem;
}

.pageTitle {
  font-size: 1.6rem;
  font-weight: 700;
  color: #1a1a2e;
  margin: 0 0 0.4rem 0;
}

.pageSubtitle {
  font-size: 0.9rem;
  color: #6c757d;
  margin: 0;
  line-height: 1.5;
}

.categorySection {
  margin-bottom: 2rem;
}

.categoryTitle {
  font-size: 1rem;
  font-weight: 600;
  color: #495057;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0 0 0.75rem 0;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #e9ecef;
}

.tableWrapper {
  overflow-x: auto;
  border-radius: 8px;
  border: 1px solid #dee2e6;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.configTable {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
  font-size: 0.875rem;

  th {
    background: #f8f9fa;
    color: #495057;
    font-weight: 600;
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid #dee2e6;
    white-space: nowrap;
  }

  td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f1f3f5;
    vertical-align: middle;
    color: #212529;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background: #f8f9fa;
  }
}

.colKey   { width: 25%; }
.colDesc  { width: 35%; }
.colValue { width: 28%; }
.colAction{ width: 12%; }

.keyCell {
  font-family: monospace;
}

.keyCode {
  background: #e9ecef;
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 0.8rem;
  color: #495057;
  word-break: break-all;
}

.descCell {
  color: #6c757d;
  font-size: 0.85rem;
}

.valueText {
  font-weight: 500;
  color: #0d6efd;
  word-break: break-all;
}

.editInput {
  width: 100%;
  padding: 0.4rem 0.6rem;
  border: 1px solid #0d6efd;
  border-radius: 4px;
  font-size: 0.875rem;
  outline: none;
  box-sizing: border-box;

  &:focus {
    box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.2);
  }
}

.rowEditing td {
  background: #f0f7ff !important;
}

.editActions {
  display: flex;
  gap: 0.4rem;
}

.editBtn {
  padding: 0.3rem 0.75rem;
  background: transparent;
  border: 1px solid #0d6efd;
  border-radius: 4px;
  color: #0d6efd;
  font-size: 0.8rem;
  cursor: pointer;
  white-space: nowrap;

  &:hover {
    background: #0d6efd;
    color: #fff;
  }
}

.saveBtn {
  padding: 0.3rem 0.75rem;
  background: #0d6efd;
  border: 1px solid #0d6efd;
  border-radius: 4px;
  color: #fff;
  font-size: 0.8rem;
  cursor: pointer;
  white-space: nowrap;

  &:hover {
    background: #0b5ed7;
  }
}

.cancelBtn {
  padding: 0.3rem 0.75rem;
  background: transparent;
  border: 1px solid #6c757d;
  border-radius: 4px;
  color: #6c757d;
  font-size: 0.8rem;
  cursor: pointer;
  white-space: nowrap;

  &:hover {
    background: #6c757d;
    color: #fff;
  }
}

.readonlyBadge {
  display: inline-block;
  padding: 0.2rem 0.5rem;
  background: #e9ecef;
  border-radius: 4px;
  font-size: 0.75rem;
  color: #6c757d;
}

.actionCell {
  white-space: nowrap;
}
