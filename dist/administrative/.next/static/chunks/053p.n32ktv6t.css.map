.Sidebar {
  background-color: rgb(241, 242, 247);
  display: flex;
  flex-direction: column;

  width: 260px;

  height: calc(100dvh - 38px);

  padding-left: 20px;

  box-sizing: border-box;

  /* 🔑 THIS IS CRITICAL */
  align-items: stretch;

  overflow-y: auto;
  overflow-x: hidden;

  font: 400 12px/1 Poppins, sans-serif;

  .brand {
    display: flex;
    align-items: center;
    gap: 10px; /* space between icon and text */
    margin: 25px 0 20px 20px;
    font-size: 12px;
    font-weight: 700;
  }

  .brandIcon {
    background-color: rgb(90, 103, 186);
    border-radius: 50%;
    color: #fff;
    width: 32px; /* slightly bigger for visibility */
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .brandName {
    color: rgb(90, 103, 186);
    letter-spacing: 0.5px;
  }

  .menuHeader {
    color: rgb(8, 36, 49);
    font-size: 11px;
    letter-spacing: 1px;
    margin: 20px 0 12px 20px;
  }

  .menuSection {
    width: 100%;
  }

  /* ✅ SAME layout for normal, hover, active */
  .menuItem,
  .activeMenuItem {
    display: flex;
    gap: 12px;
    align-items: center;

    width: 100%;
    box-sizing: border-box;
    text-align: left;

    padding: 12px 20px;
    margin: 0;

    color: rgb(39, 50, 64);
    letter-spacing: 0.5px;
    cursor: pointer;
    border: none;
    text-decoration: none;

    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .menuItem:hover {
    background-color: #e0e7ff;
    color: #5a67d8;
  }

  .activeMenuItem {
    background-color: #5a67d8;
    color: #ffffff;
    font-weight: 500;
  }

  .activeMenuItem .menuIcon {
    filter: brightness(0) invert(1);
  }

  .menuIcon {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .menuLabel {
    flex-grow: 1;
  }

  @media (max-width: 991px) {
    .brand {
      margin-left: 10px;
    }

    .menuHeader {
      margin-left: 10px;
    }
  }

  .menuItemWrapper.open .subMenu {
    opacity: 1;
    transform: translateY(0);
    max-height: 500px;
    pointer-events: auto;
    margin-top: 5px;
  }
  .menuItemWrapper:hover .subMenu {
    opacity: 1;
    transform: translateY(0);
    max-height: 500px;
    pointer-events: auto;
  }
 
  .subMenu {
    margin-left: 20px;
    padding-left: 12px;
 
    opacity: 0;
    transform: translateY(-6px);
    max-height: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: rgb(242, 242, 242);
 
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      max-height 0.5s ease;
  }
 
  .subMenu .menuItem {
    font-size: 13px;
    padding: 8px 12px;
    margin: 6px 0;
    width: 90%;
  }
 
  .subMenu .menuItem:hover {
    background-color: #eef2ff;
    color: #5a67d8;
  }
}
