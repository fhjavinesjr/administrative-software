.EarningLeave {
    font-family: "Segoe UI", sans-serif;

    
}

.EarningLeaveTable {
  font-family: "Segoe UI", Arial, sans-serif;
  font-size: 0.9rem;

  .earnedLeaveInput {
    width: 80px;            // make the input wider
    text-align: right;      // align text to the right
    padding: 6px 6px;       // optional padding
    border: 1px solid #ccc; // border style
    border-radius: 4px;     // rounded corners
    font-size: 0.9rem;

    &:focus {
        border: 2px solid #5A67D8;  // violet border on focus
        outline: none;               // remove default browser outline
    }
  }


  .tableContainer {
    overflow-x: auto;
    max-height: 600px;
    overflow-y: auto;
    
    display: flex;
    justify-content: center;
    // border: 1px solid #ddd;
  }

  .earningTable {
    width: 50%;
    margin: 0 auto; 
    border-collapse: collapse;
    text-align: center;
    
  }

  .earningTable th,
  .earningTable td {
    border: 1px solid #ddd;
    padding: 0.5rem;
  }

  .earningTable thead {
    background-color: #ddd;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 10px;
    gap: 8px;
  }

  .newButton,
  .saveButton,
  .clearButton {
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    border: none;
    font-weight: 600;
  }

  .newButton {
    background-color: #2b7a78;
    color: white;
  }

  .saveButton {
    background-color: #1d72b8;
    color: white;
  }

  .clearButton {
    background-color: #c82333;
    color: white;
  }
}

.EarningLeaveTableHistory {
  background-color: #fafafa;
  border-radius: 12px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  margin-bottom: 20px;

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;

    th,
    td {
      border: 1px solid #ccc;
      padding: 0.75rem;
      text-align: center;
    }

    thead {
      background-color: #f1f1f1;
      font-weight: bold;
    }

    tbody tr:nth-child(even) {
      background-color: #f9f9f9;
    }

    td:nth-child(8) {
      font-size: 0.9rem;
      color: #555;
    }
  }

  .actions {
    position: relative;
    display: inline-block;
  }

  .actionButton {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 6px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-width: 160px; // ensure consistent width

    button {
      display: flex;              // ✅ make row layout
      align-items: center;        // ✅ vertical center
      gap: 8px;                   // ✅ spacing between icon + text
      background: none;
      border: none;
      padding: 8px 12px;
      text-align: left;
      cursor: pointer;
      font-size: 0.9rem;

      &:hover {
        background-color: #f5f5f5;
      }

      svg,
      img,
      span {
        flex-shrink: 0; // keep icons from shrinking
      }
    }
  }


  .iconButton {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    margin: 0 6px;
    transition: transform 0.2s ease, color 0.2s ease;

    &:hover {
      transform: scale(1.2);
    }
  }

  .editIcon {
    color: #0d6efd; // Bootstrap primary blue

    &:hover {
      color: #0a58ca; // darker blue on hover
    }
  }

  .deleteIcon {
    color: #dc3545; // Bootstrap danger red

    &:hover {
      color: #bb2d3b; // darker red on hover
    }
  }

  .actionsCell {
    display: flex;
    justify-content: center;
    align-items: center;
  }

}
