.SalarySchedule {
  font-family: "Segoe UI", sans-serif;

  .tabsHeader {
    display: flex;
    justify-content: flex-start;
    gap: 6px;
    background-color: #f7f9fc;
    padding: 6px;
    border-radius: 8px;
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.05);
    margin-bottom: 20px;
  }

  .tabButton {
    flex: none;
    padding: 10px 18px;
    border: none;
    border-radius: 6px;
    background: linear-gradient(to bottom, #ffffff, #f1f3f6);
    font-size: 14px;
    font-weight: 500;
    color: #555;
    cursor: pointer;
    transition: all 0.25s ease;

    &:hover {
      background: linear-gradient(to bottom, #f9fafc, #e9edf3);
      color: #007bff;
    }

    &.active {
      background: #007bff;
      color: #fff;
      box-shadow: 0 2px 6px rgba(0, 123, 255, 0.2);
      font-weight: 600;
    }

    &:active {
      transform: scale(0.98);
    }
  }

  .tabContent {

    .tabHeader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;

      h2 {
        font-size: 20px;
        font-weight: 600;
        color: #333;
      }

      .versionSelect {
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 6px 8px;
        font-size: 14px;
        cursor: pointer;
        background-color: #fff;
        transition: border-color 0.2s ease;

        &:hover,
        &:focus {
          border-color: #007bff;
          outline: none;
        }
      }
    }
  }
}