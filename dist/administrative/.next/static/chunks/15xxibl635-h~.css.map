
.SalaryScheduleTrailTable {
  margin-bottom: 20px;

  .tableContainer {
    overflow-x: auto;
    border: 1px solid #ddd;
    border-radius: 8px;
  }

  .iconButton {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 20px;
    margin: 0 6px;
    transition: transform 0.2s ease, color 0.2s ease;

    &:hover {
      transform: scale(1.2);
    }
  }

  .editIcon {
    color: #0d6efd; // Bootstrap primary blue

    &:hover {
      color: #0a58ca; // darker blue on hover
    }
  }

  .deleteIcon {
    color: #dc3545; // Bootstrap danger red

    &:hover {
      color: #bb2d3b; // darker red on hover
    }
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;

    th,
    td {
      border: 1px solid #ddd;
      padding: 0.6rem 0.8rem;
      text-align: left;
    }

    thead {
      background-color: #f5f5f5;
      font-weight: 600;
    }

    tbody tr:nth-child(even) {
      background-color: #fafafa;
    }

    tbody tr:hover {
      background-color: #f0f8ff;
    }
  }

  .activeStatus {
    background-color: #e0fbe0;
    color: #1a7f1a;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .archivedStatus {
    background-color: #fbeaea;
    color: #a52a2a;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.85rem;
  }
}