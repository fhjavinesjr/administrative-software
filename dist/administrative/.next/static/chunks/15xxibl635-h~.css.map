
.SalaryScheduleForm {
  border: 1px solid #ddd;
  background-color: #fafafa;
  padding: 1.5rem;
  border-radius: 12px;
  margin-bottom: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;

  .formRow {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;

    @media (min-width: 768px) {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    input {
      padding: 0.5rem;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 0.95rem;
    }
  }

  .label {
    font-weight: 500;
    color: #333;
    width: 240px;
    min-width: 200px;
  }

  .inlineGroup {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;

    span {
      font-size: 0.9rem;
      color: #444;
    }
  }

  .shortInput {
    width: 80px;
    padding: 0.4rem 0.5rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: border-color 0.2s ease;

    &:focus {
      border-color: #007bff;
      outline: none;
    }
  }

  .dated {
    margin-left: 0.5rem;
  }

  .datePicker {
    width: 140px;
    padding: 0.4rem 0.5rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 0.9rem;
    background-color: #fff;
    transition: border-color 0.2s ease;

    &:focus {
      border-color: #007bff;
      outline: none;
    }
  }
}